# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+asyncpg://dockhand:dockhand@localhost:5432/dockhand

# Ring
RING_API_BASE_URL=https://api.amazonvision.com
RING_OAUTH_BASE_URL=https://oauth.ring.com
# Ring Developer Playground one-click token (expires after ~30 min)
RING_ACCESS_TOKEN=
RING_WEBHOOK_SECRET=
# ring_playground | ring_device | own_footage
MEDIA_SOURCE=ring_playground

# AWS / Bedrock (credentials come from the standard AWS chain: env, ~/.aws, SSO)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
EXTRACTION_PROMPT_VERSION=v1
