# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+asyncpg://dockhand:dockhand@localhost:55432/dockhand

# Ring
RING_API_BASE_URL=https://api.amazonvision.com
RING_OAUTH_BASE_URL=https://oauth.ring.com
# Ring Developer Playground one-click token (expires after ~30 min)
RING_ACCESS_TOKEN=
# HMAC Signature Key from the app's credentials. Webhooks are refused while it is unset.
RING_WEBHOOK_SECRET=
# ring_playground | ring_device
MEDIA_SOURCE=ring_playground

# Ingest. Relevant events as JSON list of `type` or `type.sub_type`.
INGEST_RELEVANT_EVENTS=["motion_detected.human","button_press"]
CAPTURE_MAX_EVENT_AGE_S=120
QUEUE_WORKERS=2
# Capture and frame selection
CAPTURE_STALL_S=2.0
CAPTURE_TIMEOUT_S=25
# Stop once nothing has moved for CAPTURE_SETTLE_S (0 disables), never before CAPTURE_MIN_S
CAPTURE_SETTLE_S=3.0
CAPTURE_MIN_S=4.0
CAPTURE_SETTLE_THRESHOLD=3.0
CAPTURE_SAMPLE_FRAMES=10
CAPTURE_SELECT_FRAMES=3
CAPTURE_SHARPNESS_WEIGHT=0.5
# Optional directory of <device_id>.jpg empty-scene references
CAPTURE_REFERENCE_DIR=
MEDIA_DIR=data/media
# Directory holding eval/results and bench/results (GET /v1/metrics)
RESULTS_ROOT=.
# Event History polling fallback (seconds; 0 = off). The Playground does not send webhooks.
RING_POLL_INTERVAL_S=0
RING_POLL_EVENT_TYPES=motion.human,ding
# Bearer token for POST /v1/trigger. Leave empty to disable the endpoint.
ADMIN_TOKEN=
# Allow POST /v1/admin/reset-day (scripts/reset_demo_day.py). Keep false in deployments.
ALLOW_DEMO_RESET=false

# AWS / Bedrock. Either a Bedrock API key (bearer token) or the standard AWS credential
# chain (env, ~/.aws, SSO). The API key wins when both are present.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Nova rejects Converse outputConfig; true for models that support structured output (Claude).
BEDROCK_STRUCTURED_OUTPUT=false
# The extraction eval also runs this model on the same set and reports both.
BEDROCK_COMPARISON_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_COMPARISON_STRUCTURED_OUTPUT=true
EXTRACTION_PROMPT_VERSION=v1

# Reconciliation (see docs/decisions.md)
BUSINESS_TIMEZONE=America/New_York
RECONCILE_INTERVAL_S=300
RECONCILE_GRACE_MINUTES=60
RECONCILE_MAX_COST=1.0
RECONCILE_CARRIER_MISMATCH_COST=0.5
RECONCILE_CARRIER_UNKNOWN_COST=0.2
RECONCILE_TIME_COST_PER_HOUR=0.15
RECONCILE_MAX_OFFSET_HOURS=8.0
RECONCILE_COUNT_COST_WEIGHT=0.5

# MCP server (mcp_server/, port 8020) and the assistant that calls it. The MCP server refuses
# to start without MCP_TOKEN; the API's assistant sends it as a bearer token.
MCP_TOKEN=
MCP_URL=http://localhost:8020/mcp
# Base URL of the MCP server as clients see it: snapshot links in tool results point here.
MCP_PUBLIC_URL=http://localhost:8020
# Signed snapshot links expire after this many seconds. MCP_MEDIA_KEY defaults to a key derived
# from MCP_TOKEN.
MCP_MEDIA_TTL_S=3600
MCP_MEDIA_KEY=
# DNS-rebinding protection: extra allowed Host / Origin values (JSON lists). MCP_PUBLIC_URL's
# host and origin are always allowed.
MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*"]
MCP_ALLOWED_ORIGINS=[]
MCP_INCLUDE_SIMULATED=true
MCP_RATE_LIMIT_PER_MIN=120
# Assistant model (Bedrock Converse with tool use); empty = BEDROCK_MODEL_ID
ASSISTANT_MODEL_ID=
ASSISTANT_MAX_STEPS=6
BUSINESS_NAME=
