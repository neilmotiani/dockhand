# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+asyncpg://dockhand:dockhand@localhost:5432/dockhand

# Ring
RING_API_BASE_URL=https://api.amazonvision.com
RING_OAUTH_BASE_URL=https://oauth.ring.com
# Ring Developer Playground one-click token (expires after ~30 min)
RING_ACCESS_TOKEN=
RING_WEBHOOK_SECRET=
# ring_playground | ring_device | own_footage
MEDIA_SOURCE=ring_playground

# AWS / Bedrock. Either a Bedrock API key (bearer token) or the standard AWS credential
# chain (env, ~/.aws, SSO). The API key wins when both are present.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
EXTRACTION_PROMPT_VERSION=v1

# Reconciliation (see docs/decisions.md)
RECONCILE_GRACE_MINUTES=60
RECONCILE_MAX_COST=1.0
RECONCILE_CARRIER_MISMATCH_COST=0.5
RECONCILE_CARRIER_UNKNOWN_COST=0.2
RECONCILE_TIME_COST_PER_HOUR=0.15
RECONCILE_MAX_OFFSET_HOURS=8.0
RECONCILE_COUNT_COST_WEIGHT=0.5
